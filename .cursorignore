# Bulk / generated trees — keep out of Cursor index
external_data/**
cache/**
scratch/**
artifacts/**
runs/**
checkpoints/**
outputs/**
data/scratch/**
data/staging/**
data/canonical/catalog/**
data/canonical/matrices/**
data/canonical/graphs/**
data/canonical/static_features/**
data/canonical/registries/**
data/canonical/annotations/**

# Heavy raw downloads (matrices, arrows, zip packs, All Data text)
data/raw/cpgcorpus/**
data/raw/ewas_datahub/EWAS_db/**
data/raw/ewas_datahub/download/**
data/raw/ewas_datahub/add_ewas_db/**
data/raw/manifests/epicv2/*.csv.gz
data/raw/methylgpt/pretrained_models/**

# Large Atlas tables (keep small studies/cohorts/trait matrix indexed)
data/raw/ewas_atlas/EWAS_Atlas_associations.tsv
data/raw/ewas_atlas/EWAS_Atlas_probe_annotations.tsv

# Parquet phenotype extracts are binary; .txt under reports/ is preferred
data/canonical/phenotypes/**/*.parquet
data/canonical/phenotypes/.extract_*/**

