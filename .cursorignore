# Reference repositories — targeted inspection only
vendor/**/.git/**
vendor/**/data/**
vendor/**/dependencies/**
vendor/**/pretrained_models/**
vendor/**/results/**
vendor/infinium_annotation/**/*.cm
vendor/infinium_annotation/**/*.cm.idx
