# Copy to .env and source scripts/activate_data_environment.sh.
# All paths must remain under /data.

MBS_PROJECT_ROOT=/data/projects/methyl-burden-score
MBS_DATA_ROOT=/data/datasets/methyl-burden-score
MBS_SCRATCH_ROOT=/data/scratch/methyl-burden-score
MBS_CACHE_ROOT=/data/cache/methyl-burden-score
MBS_ARTIFACT_ROOT=/data/artifacts/methyl-burden-score
MBS_DOCKER_ROOT=/data/docker

# Tool caches
UV_CACHE_DIR=/data/cache/uv
PIP_CACHE_DIR=/data/cache/pip
HF_HOME=/data/cache/huggingface
HUGGINGFACE_HUB_CACHE=/data/cache/huggingface/hub
TRANSFORMERS_CACHE=/data/cache/huggingface/transformers
TORCH_HOME=/data/cache/torch
XDG_CACHE_HOME=/data/cache/xdg
NUMBA_CACHE_DIR=/data/cache/numba
MPLCONFIGDIR=/data/cache/matplotlib

# Temporary and experiment outputs
TMPDIR=/data/scratch/methyl-burden-score/tmp
TEMP=/data/scratch/methyl-burden-score/tmp
TMP=/data/scratch/methyl-burden-score/tmp
WANDB_DIR=/data/artifacts/methyl-burden-score/wandb
WANDB_CACHE_DIR=/data/cache/methyl-burden-score/wandb
MLFLOW_TRACKING_URI=file:/data/artifacts/methyl-burden-score/mlruns

# Optional local resource controls
MBS_NUM_WORKERS=8
OMP_NUM_THREADS=8
MKL_NUM_THREADS=8
TOKENIZERS_PARALLELISM=false
PYTHONUNBUFFERED=1

# Never commit credentials here. Configure AWS, Hugging Face, W&B, and other
# credentials through server-managed secret files or environment injection.
