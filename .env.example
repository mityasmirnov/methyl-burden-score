# Copy to .env and source scripts/activate_data_environment.sh.
# Defaults are project-local under the repo so no shared /data/* ownership is required.
# Override any path if you have writable shared mounts.

# Project root (MBS_PROJECT_ROOT is kept as a compatibility alias)
export MBS_ROOT=/data/projects/methyl-burden-score
export MBS_PROJECT_ROOT=$MBS_ROOT

# Writable project-local folders
export MBS_DATA_ROOT=$MBS_ROOT/data
export MBS_SCRATCH_ROOT=$MBS_ROOT/scratch
export MBS_CACHE_ROOT=$MBS_ROOT/cache
export MBS_ARTIFACT_ROOT=$MBS_ROOT/artifacts
export MBS_DOCKER_ROOT=$MBS_ROOT/docker

# Tool caches
export XDG_CACHE_HOME=$MBS_CACHE_ROOT/xdg
export HF_HOME=$MBS_CACHE_ROOT/huggingface
export HUGGINGFACE_HUB_CACHE=$HF_HOME/hub
export TRANSFORMERS_CACHE=$HF_HOME/transformers
export TORCH_HOME=$MBS_CACHE_ROOT/torch
export UV_CACHE_DIR=$MBS_CACHE_ROOT/uv
export PIP_CACHE_DIR=$MBS_CACHE_ROOT/pip
export NUMBA_CACHE_DIR=$MBS_CACHE_ROOT/numba
export MPLCONFIGDIR=$MBS_CACHE_ROOT/matplotlib

# Temporary and experiment outputs
export TMPDIR=$MBS_SCRATCH_ROOT/tmp
export TEMP=$TMPDIR
export TMP=$TMPDIR
export WANDB_DIR=$MBS_ARTIFACT_ROOT/wandb
export WANDB_CACHE_DIR=$MBS_CACHE_ROOT/wandb
export MLFLOW_TRACKING_URI=file:$MBS_ARTIFACT_ROOT/mlruns

# Optional local resource controls
export MBS_NUM_WORKERS=8
export OMP_NUM_THREADS=8
export MKL_NUM_THREADS=8
export TOKENIZERS_PARALLELISM=false
export PYTHONUNBUFFERED=1

# Never commit credentials here. Configure AWS, Hugging Face, W&B, and other
# credentials through server-managed secret files or environment injection.
