reports/inspection/private/

# vendor/* checkouts are Git submodules (mode 160000 pointers in the index).
# Only vendor/README.md and vendor/SOURCES.lock.yaml are ordinary tracked files.

# Keep explicit tiny text fixtures and manifests
!tests/fixtures/**
!tests/fixtures/**/*.csv
!tests/fixtures/**/*.tsv
!tests/fixtures/**/*.json
!tests/fixtures/**/*.yaml
!tests/fixtures/**/*.yml
!reports/inspection/.gitkeep

